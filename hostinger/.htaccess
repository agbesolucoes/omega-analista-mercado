# Analista de Mercado Omega: configuração para hospedagem Apache/LiteSpeed (Hostinger)
Options -Indexes
DirectoryIndex index.html

# Força HTTPS
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# O index.html muda a cada versão: o navegador sempre confere se há atualização
<FilesMatch "\.html$">
  Header set Cache-Control "no-cache"
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/markdown text/plain
</IfModule>
